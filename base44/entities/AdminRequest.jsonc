{
  "name": "AdminRequest",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nombre completo del solicitante"
    },
    "contact_email": {
      "type": "string",
      "description": "Email de contacto y recuperaci\u00f3n"
    },
    "company_name": {
      "type": "string",
      "description": "Nombre de la empresa"
    },
    "company_cif": {
      "type": "string",
      "description": "CIF de la empresa (clave \u00fanica por empresa)"
    },
    "company_address": {
      "type": "string",
      "description": "Direcci\u00f3n de la empresa"
    },
    "technician_email": {
      "type": "string",
      "description": "Email de la cuenta t\u00e9cnico existente a vincular como administrador (opcional)"
    },
    "password": {
      "type": "string",
      "description": "Contrase\u00f1a elegida por el solicitante (se asigna como portal_password del administrador al aprobar)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Estado de la solicitud"
    },
    "notes": {
      "type": "string",
      "description": "Notas del administrador sobre la solicitud"
    }
  },
  "required": [
    "full_name",
    "contact_email",
    "company_name",
    "company_cif"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}