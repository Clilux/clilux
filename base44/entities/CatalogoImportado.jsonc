{
  "name": "CatalogoImportado",
  "type": "object",
  "properties": {
    "nombre_catalogo": {
      "type": "string",
      "description": "Nombre identificativo del cat\u00e1logo importado"
    },
    "fabricante": {
      "type": "string",
      "description": "Fabricante principal del cat\u00e1logo"
    },
    "fecha_importacion": {
      "type": "string",
      "format": "date",
      "description": "Fecha de importaci\u00f3n"
    },
    "num_productos": {
      "type": "number",
      "description": "N\u00famero de productos importados"
    },
    "archivo_url": {
      "type": "string",
      "description": "URL del archivo original importado"
    }
  },
  "required": [
    "nombre_catalogo",
    "fabricante",
    "fecha_importacion"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}