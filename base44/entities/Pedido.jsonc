{
  "name": "Pedido",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "description": "N\u00famero de pedido"
    },
    "proveedor_id": {
      "type": "string",
      "description": "ID del proveedor"
    },
    "proveedor_nombre": {
      "type": "string",
      "description": "Nombre del proveedor (desnormalizado)"
    },
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "fecha_entrega": {
      "type": "string",
      "format": "date",
      "description": "Fecha de entrega prevista"
    },
    "lineas": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "concepto": {
            "type": "string"
          },
          "cantidad": {
            "type": "number"
          },
          "precio_unitario": {
            "type": "number"
          },
          "descuento": {
            "type": "number",
            "default": 0
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "iva": {
      "type": "number",
      "default": 21
    },
    "total": {
      "type": "number"
    },
    "estado": {
      "type": "string",
      "enum": [
        "borrador",
        "enviado",
        "recibido_parcial",
        "recibido",
        "cancelado"
      ],
      "default": "borrador"
    },
    "obra_id": {
      "type": "string",
      "description": "Obra a la que se imputa el pedido (opcional)"
    },
    "obra_nombre": {
      "type": "string"
    },
    "notas": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "numero",
    "fecha"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}