{
  "name": "Technician",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del t\u00e9cnico"
    },
    "email": {
      "type": "string",
      "description": "Email del t\u00e9cnico"
    },
    "phone": {
      "type": "string"
    },
    "specialty": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "Foto de perfil del t\u00e9cnico"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "user_email": {
      "type": "string",
      "description": "Email de cuenta base44 vinculada"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "is_admin": {
      "type": "boolean",
      "default": false
    },
    "worker_type": {
      "type": "string",
      "enum": [
        "tecnico",
        "administracion"
      ],
      "default": "tecnico",
      "description": "Tipo de trabajador: t\u00e9cnico de campo o personal de administraci\u00f3n"
    },
    "portal_email": {
      "type": "string"
    },
    "portal_password": {
      "type": "string"
    },
    "pin": {
      "type": "string",
      "description": "PIN num\u00e9rico personal para fichar en el kiosko (4-6 d\u00edgitos). Lo crea el propio trabajador desde su perfil."
    },
    "invited_at": {
      "type": "string"
    },
    "fgas_cert_num": {
      "type": "string",
      "description": "N\u00ba de certificado personal F-Gas (carn\u00e9 frigorista)"
    },
    "rite_cert_num": {
      "type": "string",
      "description": "N\u00ba de carn\u00e9 RITE / habilitaci\u00f3n como mantenedor de instalaciones t\u00e9rmicas"
    },
    "empresa_fgas_cert_num": {
      "type": "string",
      "description": "N\u00ba de certificado de empresa habilitada F-Gas (si el t\u00e9cnico trabaja en su propia empresa)"
    },
    "horas_jornada_diaria": {
      "type": "number",
      "default": 8,
      "description": "Horas de jornada laboral diaria pactada"
    },
    "dias_laborables": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [
        1,
        2,
        3,
        4,
        5
      ],
      "description": "D\u00edas laborables: 0=Dom, 1=Lun, ..., 6=S\u00e1b"
    },
    "vacaciones_anuales": {
      "type": "number",
      "default": 22,
      "description": "D\u00edas de vacaciones anuales pactados"
    },
    "vacaciones_dias_usados_anteriores": {
      "type": "number",
      "default": 0
    },
    "vacaciones_notas": {
      "type": "string"
    },
    "permisos": {
      "type": "object",
      "description": "Permisos de acceso del t\u00e9cnico al portal",
      "properties": {
        "ver_clientes": {
          "type": "boolean",
          "default": true
        },
        "editar_clientes": {
          "type": "boolean",
          "default": false
        },
        "ver_edificios": {
          "type": "boolean",
          "default": true
        },
        "ver_equipos": {
          "type": "boolean",
          "default": true
        },
        "editar_equipos": {
          "type": "boolean",
          "default": false
        },
        "ver_incidencias": {
          "type": "boolean",
          "default": true
        },
        "editar_incidencias": {
          "type": "boolean",
          "default": true
        },
        "ver_revisiones": {
          "type": "boolean",
          "default": true
        },
        "editar_revisiones": {
          "type": "boolean",
          "default": true
        },
        "ver_horario": {
          "type": "boolean",
          "default": true
        },
        "ver_ausencias": {
          "type": "boolean",
          "default": true
        },
        "ver_documentacion": {
          "type": "boolean",
          "default": true
        },
        "ver_contratos": {
          "type": "boolean",
          "default": false
        },
        "ver_scada": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}