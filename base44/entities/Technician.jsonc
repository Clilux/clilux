{
  "name": "Technician",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del t\u00e9cnico"
    },
    "email": {
      "type": "string",
      "description": "Email del t\u00e9cnico"
    },
    "phone": {
      "type": "string"
    },
    "specialty": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "user_email": {
      "type": "string",
      "description": "Email de cuenta base44 vinculada"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "is_admin": {
      "type": "boolean",
      "default": false
    },
    "portal_email": {
      "type": "string"
    },
    "portal_password": {
      "type": "string"
    },
    "invited_at": {
      "type": "string"
    },
    "horas_jornada_diaria": {
      "type": "number",
      "default": 8,
      "description": "Horas de jornada laboral diaria pactada"
    },
    "dias_laborables": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [
        1,
        2,
        3,
        4,
        5
      ],
      "description": "D\u00edas laborables: 0=Dom, 1=Lun, ..., 6=S\u00e1b"
    },
    "permisos": {
      "type": "object",
      "description": "Permisos de acceso del t\u00e9cnico al portal",
      "properties": {
        "ver_clientes": {
          "type": "boolean",
          "default": true
        },
        "editar_clientes": {
          "type": "boolean",
          "default": false
        },
        "ver_edificios": {
          "type": "boolean",
          "default": true
        },
        "ver_equipos": {
          "type": "boolean",
          "default": true
        },
        "editar_equipos": {
          "type": "boolean",
          "default": false
        },
        "ver_incidencias": {
          "type": "boolean",
          "default": true
        },
        "editar_incidencias": {
          "type": "boolean",
          "default": true
        },
        "ver_revisiones": {
          "type": "boolean",
          "default": true
        },
        "editar_revisiones": {
          "type": "boolean",
          "default": true
        },
        "ver_horario": {
          "type": "boolean",
          "default": true
        },
        "ver_ausencias": {
          "type": "boolean",
          "default": true
        },
        "ver_documentacion": {
          "type": "boolean",
          "default": true
        },
        "ver_contratos": {
          "type": "boolean",
          "default": false
        },
        "ver_scada": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "required": [
    "name",
    "email"
  ]
}