{
  "name": "Technician",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del t\u00e9cnico"
    },
    "email": {
      "type": "string",
      "description": "Email del t\u00e9cnico"
    },
    "phone": {
      "type": "string"
    },
    "specialty": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "user_email": {
      "type": "string",
      "description": "Email de cuenta base44 vinculada"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "is_admin": {
      "type": "boolean",
      "default": false
    },
    "portal_email": {
      "type": "string"
    },
    "portal_password": {
      "type": "string"
    },
    "invited_at": {
      "type": "string"
    },
    "horas_jornada_diaria": {
      "type": "number",
      "default": 8,
      "description": "Horas de jornada laboral diaria pactada (para calcular horas extra)"
    },
    "dias_laborables": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [
        1,
        2,
        3,
        4,
        5
      ],
      "description": "D\u00edas laborables: 0=Dom, 1=Lun, ..., 6=S\u00e1b"
    }
  },
  "required": [
    "name",
    "email"
  ]
}