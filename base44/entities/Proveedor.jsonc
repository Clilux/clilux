{
  "name": "Proveedor",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre o raz\u00f3n social del proveedor"
    },
    "cif": {
      "type": "string",
      "description": "CIF/NIF del proveedor"
    },
    "contacto": {
      "type": "string",
      "description": "Persona de contacto"
    },
    "email": {
      "type": "string",
      "description": "Email de pedidos"
    },
    "telefono": {
      "type": "string"
    },
    "direccion": {
      "type": "string"
    },
    "ciudad": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "provincia": {
      "type": "string"
    },
    "web": {
      "type": "string"
    },
    "iban": {
      "type": "string",
      "description": "Cuenta bancaria para pagos"
    },
    "notas": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "company_id": {
      "type": "string",
      "description": "ID de la empresa propietaria"
    },
    "created_by_name": {
      "type": "string",
      "description": "Usuario que cre\u00f3 la ficha"
    }
  },
  "required": [
    "nombre"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}