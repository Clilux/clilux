{
  "name": "BuildingDocument",
  "type": "object",
  "properties": {
    "building_id": {
      "type": "string",
      "description": "ID del edificio al que pertenece el documento"
    },
    "client_id": {
      "type": "string",
      "description": "ID del cliente propietario"
    },
    "company_id": {
      "type": "string",
      "description": "ID de la empresa mantenedora"
    },
    "year": {
      "type": "number",
      "description": "A\u00f1o al que corresponde el libro"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "libro_mantenimiento",
        "libro_fgas"
      ],
      "description": "Tipo de libro anual generado"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo visible del documento"
    },
    "file_uri": {
      "type": "string",
      "description": "URI privada del PDF generado"
    },
    "resumen": {
      "type": "string",
      "description": "Resumen del contenido del libro (equipos, revisiones, tCO2eq...)"
    },
    "generated_by_name": {
      "type": "string",
      "description": "Usuario que gener\u00f3 el documento"
    }
  },
  "required": [
    "building_id",
    "year",
    "tipo",
    "titulo",
    "file_uri"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}