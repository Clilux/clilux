{
  "name": "BuildingDocument",
  "type": "object",
  "properties": {
    "building_id": {
      "type": "string",
      "description": "ID del edificio al que pertenece el documento"
    },
    "client_id": {
      "type": "string",
      "description": "ID del cliente propietario"
    },
    "company_id": {
      "type": "string",
      "description": "ID de la empresa mantenedora"
    },
    "year": {
      "type": "number",
      "description": "A\u00f1o al que corresponde el documento (solo en los libros anuales generados)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "libro_mantenimiento",
        "libro_fgas",
        "plano",
        "documento_acceso",
        "seguro",
        "otro"
      ],
      "description": "Tipo de documento: libros anuales generados o archivos aportados (planos, accesos, seguros, otros)"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo visible del documento"
    },
    "file_uri": {
      "type": "string",
      "description": "URI privada del archivo"
    },
    "nombre_original": {
      "type": "string",
      "description": "Nombre original del archivo subido"
    },
    "resumen": {
      "type": "string",
      "description": "Resumen del contenido del libro (equipos, revisiones, tCO2eq...)"
    },
    "generated_by_name": {
      "type": "string",
      "description": "Usuario que subi\u00f3 o gener\u00f3 el documento"
    }
  },
  "required": [
    "building_id",
    "tipo",
    "titulo",
    "file_uri"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}