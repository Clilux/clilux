{
  "name": "Factura",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "description": "N\u00famero de factura"
    },
    "client_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha de emisi\u00f3n"
    },
    "albaran_id": {
      "type": "string",
      "description": "ID del albar\u00e1n origen"
    },
    "presupuesto_id": {
      "type": "string",
      "description": "ID del presupuesto origen"
    },
    "lineas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concepto": {
            "type": "string"
          },
          "cantidad": {
            "type": "number"
          },
          "precio_unitario": {
            "type": "number"
          },
          "descuento": {
            "type": "number",
            "default": 0
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "iva": {
      "type": "number",
      "default": 21
    },
    "total": {
      "type": "number"
    },
    "forma_pago": {
      "type": "string",
      "enum": [
        "contado",
        "transferencia",
        "tarjeta",
        "financiado"
      ],
      "default": "transferencia"
    },
    "observaciones": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "emitida",
        "pagada",
        "vencida",
        "anulada"
      ],
      "default": "emitida"
    },
    "verifactu_enviado": {
      "type": "boolean",
      "default": false,
      "description": "Enviado a VeriFacTu AEAT"
    },
    "verifactu_hash": {
      "type": "string",
      "description": "Hash de verificaci\u00f3n AEAT"
    }
  },
  "required": [
    "client_id",
    "fecha",
    "numero"
  ]
}