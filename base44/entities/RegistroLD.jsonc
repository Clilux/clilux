{
  "name": "RegistroLD",
  "type": "object",
  "properties": {
    "equipment_id": {
      "type": "string",
      "description": "ID del equipo"
    },
    "client_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha del tratamiento"
    },
    "tipo_tratamiento": {
      "type": "string",
      "enum": [
        "puesta_en_marcha",
        "mantenimiento_mensual",
        "tras_averia",
        "aislamiento_legionella",
        "medida_correctora",
        "brote_casos"
      ],
      "description": "Tipo de tratamiento"
    },
    "protocolo_id": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ],
      "default": "A",
      "description": "Protocolo: A=5ppm fab., B=20ppm RD est\u00e1ndar, C=50ppm RD r\u00e1pido"
    },
    "nombre_circuito": {
      "type": "string"
    },
    "estado_conservacion": {
      "type": "string",
      "enum": [
        "correcto",
        "con_corrosion",
        "con_incrustaciones",
        "biocapa",
        "algas"
      ]
    },
    "plano_hidraulico": {
      "type": "string",
      "enum": [
        "si",
        "no"
      ]
    },
    "hora_inicio": {
      "type": "string"
    },
    "hora_fin": {
      "type": "string"
    },
    "hora_inicio_desinfeccion": {
      "type": "string"
    },
    "hora_fin_desinfeccion": {
      "type": "string"
    },
    "balsa_litros": {
      "type": "number"
    },
    "ph_inicial": {
      "type": "number"
    },
    "cloro_libre_inicial": {
      "type": "number"
    },
    "temperatura_inicial": {
      "type": "number"
    },
    "producto_principal": {
      "type": "string",
      "default": "Hipoclorito S\u00f3dico Comercial 15%"
    },
    "producto_secundario": {
      "type": "string",
      "default": "Tiosulfato S\u00f3dico Pentahidratado"
    },
    "hipoclorito_ml": {
      "type": "number"
    },
    "tiempo_recirculacion_min": {
      "type": "number"
    },
    "cloro_durante_desinfeccion": {
      "type": "number"
    },
    "metabisulfito_g": {
      "type": "number"
    },
    "ph_final": {
      "type": "number"
    },
    "cloro_libre_final": {
      "type": "number"
    },
    "temperatura_final": {
      "type": "number"
    },
    "check_vaciado": {
      "type": "string",
      "enum": [
        "si",
        "no",
        "parcialmente"
      ],
      "default": "si"
    },
    "check_epi": {
      "type": "boolean",
      "default": false
    },
    "check_limpieza_mecanica": {
      "type": "boolean",
      "default": false
    },
    "check_llenado_limpio": {
      "type": "boolean",
      "default": false
    },
    "check_bombas_on_ventiladores_off": {
      "type": "boolean",
      "default": false
    },
    "check_neutralizado_ok": {
      "type": "boolean",
      "default": false
    },
    "bp_cepillo_suave": {
      "type": "boolean",
      "default": false
    },
    "bp_secado_diario": {
      "type": "boolean",
      "default": false
    },
    "bp_purga_sales": {
      "type": "boolean",
      "default": false
    },
    "partes_tratamiento": {
      "type": "string"
    },
    "observaciones": {
      "type": "string"
    },
    "responsable_tecnico_nombre": {
      "type": "string"
    },
    "responsable_tecnico_dni": {
      "type": "string"
    },
    "responsable_tecnico_curso": {
      "type": "string"
    },
    "responsable_tecnico_cualificacion": {
      "type": "string"
    },
    "aplicador_nombre": {
      "type": "string"
    },
    "aplicador_dni": {
      "type": "string"
    },
    "aplicador_curso": {
      "type": "string"
    },
    "aplicador_cualificacion": {
      "type": "string"
    },
    "tecnico_nombre": {
      "type": "string",
      "description": "legacy"
    },
    "proxima_revision_fecha": {
      "type": "string",
      "format": "date"
    },
    "documento_url": {
      "type": "string"
    },
    "ppm_deseadas": {
      "type": "number"
    },
    "porcentaje_hipoclorito": {
      "type": "number"
    },
    "cloro_a_neutralizar": {
      "type": "number"
    }
  },
  "required": [
    "equipment_id",
    "client_id",
    "fecha",
    "tipo_tratamiento"
  ]
}