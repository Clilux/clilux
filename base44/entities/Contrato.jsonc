{
  "name": "Contrato",
  "type": "object",
  "properties": {
    "numero_contrato": {
      "type": "string",
      "description": "N\u00famero identificador del contrato"
    },
    "tipo_contrato": {
      "type": "string",
      "enum": [
        "mantenimiento",
        "instalaciones"
      ],
      "default": "mantenimiento",
      "description": "Tipo de contrato"
    },
    "estado": {
      "type": "string",
      "enum": [
        "realizado",
        "firmado"
      ],
      "default": "realizado",
      "description": "Estado del contrato: realizado (generado) o firmado (con firma del cliente)"
    },
    "cliente_nombre": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "cliente_cif": {
      "type": "string",
      "description": "CIF/NIF del cliente"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente en el sistema (si es cliente existente)"
    },
    "company_id": {
      "type": "string",
      "description": "ID de la empresa mantenedora (para avisos de caducidad y filtrado multi-empresa)"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio del contrato"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date",
      "description": "Fecha de fin del contrato"
    },
    "duracion_meses": {
      "type": "number",
      "default": 12,
      "description": "Duraci\u00f3n del contrato en meses"
    },
    "renovacion_automatica": {
      "type": "string",
      "enum": [
        "si",
        "no"
      ],
      "default": "si",
      "description": "Si el contrato se renueva autom\u00e1ticamente al llegar a su fin. Si es 'no', el sistema avisa de la caducidad pr\u00f3xima."
    },
    "avisado_caducidad": {
      "type": "boolean",
      "default": false,
      "description": "Marca interna: el sistema ya emiti\u00f3 el aviso de caducidad para este contrato (evita avisos duplicados)."
    },
    "precio_anual": {
      "type": "number",
      "description": "Precio anual o importe total"
    },
    "forma_pago": {
      "type": "string",
      "description": "Periodicidad de pago"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL del PDF del contrato generado"
    },
    "pdf_firmado_url": {
      "type": "string",
      "description": "URL del PDF firmado por el cliente"
    },
    "form_data": {
      "type": "object",
      "description": "Todos los datos del formulario para poder editar el contrato"
    },
    "notas": {
      "type": "string",
      "description": "Notas internas sobre el contrato"
    }
  },
  "required": [
    "numero_contrato",
    "tipo_contrato",
    "cliente_nombre"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}