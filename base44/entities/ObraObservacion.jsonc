{
  "name": "ObraObservacion",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID de la obra"
    },
    "obra_nombre": {
      "type": "string",
      "description": "Nombre de la obra (desnormalizado)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "observacion",
        "incidencia"
      ],
      "default": "observacion",
      "description": "observacion = anotaci\u00f3n de la jornada. incidencia = problema detectado que requiere actuaci\u00f3n."
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo corto"
    },
    "descripcion": {
      "type": "string",
      "description": "Detalle de lo observado o del problema detectado"
    },
    "gravedad": {
      "type": "string",
      "enum": [
        "baja",
        "media",
        "alta"
      ],
      "default": "media",
      "description": "Gravedad de la incidencia"
    },
    "estado": {
      "type": "string",
      "enum": [
        "abierta",
        "resuelta"
      ],
      "default": "abierta"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fotos de la observaci\u00f3n o incidencia"
    },
    "resolucion": {
      "type": "string",
      "description": "C\u00f3mo se resolvi\u00f3 la incidencia"
    },
    "resuelta_por": {
      "type": "string"
    },
    "fecha_resolucion": {
      "type": "string",
      "format": "date"
    },
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha en la que se registra"
    },
    "registrado_por": {
      "type": "string",
      "description": "Trabajador que la registra"
    },
    "registrado_por_email": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    }
  },
  "required": [
    "obra_id",
    "titulo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}