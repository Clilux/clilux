{
  "name": "ClientDocument",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo del documento"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "certificado_rite",
        "contrato",
        "otro"
      ],
      "default": "otro",
      "description": "Tipo de documento: certificado RITE, contrato vinculado o documento subido a mano"
    },
    "file_url": {
      "type": "string",
      "description": "URL del archivo PDF guardado"
    },
    "contrato_id": {
      "type": "string",
      "description": "ID del contrato vinculado (si el documento proviene de un contrato generado)"
    },
    "num_certificado": {
      "type": "string",
      "description": "N\u00famero de certificado o n\u00famero de contrato"
    },
    "building_name": {
      "type": "string",
      "description": "Nombre del edificio/instalaci\u00f3n"
    },
    "tecnico_nombre": {
      "type": "string",
      "description": "T\u00e9cnico que realiz\u00f3 el mantenimiento"
    },
    "observaciones": {
      "type": "string",
      "description": "Observaciones del certificado"
    },
    "fecha_firma": {
      "type": "string",
      "description": "Fecha de firma del certificado"
    },
    "form_data": {
      "type": "object",
      "description": "Datos completos del formulario para visualizaci\u00f3n"
    }
  },
  "required": [
    "client_id",
    "title",
    "document_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}