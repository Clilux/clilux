{
  "name": "MenuCustomization",
  "type": "object",
  "properties": {
    "setting_key": {
      "type": "string",
      "description": "Clave \u00fanica (usar 'menu_config')"
    },
    "menu_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "page": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "order": {
            "type": "number"
          }
        }
      },
      "description": "Configuraci\u00f3n de elementos del men\u00fa"
    }
  },
  "required": [
    "setting_key"
  ]
}