{
  "name": "EquipmentSuggestions",
  "type": "object",
  "properties": {
    "setting_key": {
      "type": "string",
      "description": "Clave \u00fanica (usar 'suggestions')"
    },
    "brands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de marcas usadas"
    },
    "refrigerants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de refrigerantes usados"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de modelos usados"
    }
  },
  "required": [
    "setting_key"
  ]
}