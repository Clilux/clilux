{
  "name": "RegistroHorario",
  "type": "object",
  "properties": {
    "technician_id": {
      "type": "string"
    },
    "technician_email": {
      "type": "string"
    },
    "technician_name": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "hora_entrada": {
      "type": "string",
      "description": "HH:MM"
    },
    "hora_salida": {
      "type": "string",
      "description": "HH:MM"
    },
    "horas_trabajadas": {
      "type": "number",
      "description": "Horas brutas (sin descontar pausas)"
    },
    "horas_efectivas": {
      "type": "number",
      "description": "Horas efectivas (descontando pausas)"
    },
    "horas_normales": {
      "type": "number",
      "description": "Horas dentro de jornada pactada"
    },
    "horas_extra": {
      "type": "number",
      "description": "Horas sobre la jornada pactada"
    },
    "minutos_pausa": {
      "type": "number",
      "default": 0,
      "description": "Total minutos de pausa"
    },
    "tipo_jornada": {
      "type": "string",
      "enum": [
        "normal",
        "extra",
        "guardia"
      ],
      "default": "normal"
    },
    "notas": {
      "type": "string"
    },
    "pausas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "inicio": {
            "type": "string",
            "description": "HH:MM"
          },
          "fin": {
            "type": "string",
            "description": "HH:MM"
          },
          "motivo": {
            "type": "string"
          }
        }
      },
      "description": "Pausas durante la jornada"
    },
    "ubicacion_entrada": {
      "type": "string",
      "description": "lat,lng"
    },
    "ubicacion_salida": {
      "type": "string",
      "description": "lat,lng"
    },
    "geopoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "hora": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          }
        }
      }
    },
    "historial_modificaciones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fecha_mod": {
            "type": "string"
          },
          "usuario": {
            "type": "string"
          },
          "campo": {
            "type": "string"
          },
          "valor_anterior": {
            "type": "string"
          },
          "valor_nuevo": {
            "type": "string"
          },
          "motivo": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "technician_email",
    "fecha",
    "hora_entrada"
  ]
}