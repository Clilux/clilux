{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre o raz\u00f3n social del cliente"
    },
    "cif": {
      "type": "string",
      "description": "CIF/NIF del cliente"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n fiscal"
    },
    "city": {
      "type": "string",
      "description": "Ciudad"
    },
    "postal_code": {
      "type": "string",
      "description": "C\u00f3digo postal"
    },
    "province": {
      "type": "string",
      "description": "Provincia"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto"
    },
    "email": {
      "type": "string",
      "description": "Email de contacto"
    },
    "contact_person": {
      "type": "string",
      "description": "Persona de contacto"
    },
    "notes": {
      "type": "string",
      "description": "Observaciones"
    },
    "assigned_technician": {
      "type": "string",
      "description": "Email del t\u00e9cnico asignado (t\u00e9cnico principal)"
    },
    "assigned_technician_name": {
      "type": "string",
      "description": "Nombre del t\u00e9cnico asignado"
    },
    "tecnicos_asignados": {
      "type": "array",
      "default": [],
      "description": "Equipo de t\u00e9cnicos asignados a este cliente (pueden ser varios). El primero se considera t\u00e9cnico principal.",
      "items": {
        "type": "object",
        "properties": {
          "technician_id": {
            "type": "string"
          },
          "technician_name": {
            "type": "string"
          },
          "technician_email": {
            "type": "string"
          }
        }
      }
    },
    "tipo": {
      "type": "string",
      "enum": [
        "residencial",
        "comercial",
        "industrial"
      ],
      "default": "comercial",
      "description": "Tipo de cliente: residencial, comercial o industrial.",
      "enumColors": [
        "blue",
        "green",
        "purple"
      ]
    },
    "estado_crm": {
      "type": "string",
      "enum": [
        "activo",
        "pendiente",
        "completado",
        "cancelado"
      ],
      "default": "activo",
      "description": "Estado del cliente en el ciclo CRM (independiente del estado activo/inactivo de la ficha).",
      "enumColors": [
        "green",
        "yellow",
        "blue",
        "red"
      ]
    },
    "tarifas": {
      "type": "array",
      "default": [],
      "description": "Tarifas especiales acordadas con el cliente, visibles desde su portal.",
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Nombre de la tarifa (ej. 'Mantenimiento mensual', 'Hora t\u00e9cnica')"
          },
          "descripcion": {
            "type": "string"
          },
          "precio": {
            "type": "number",
            "description": "Precio acordado"
          },
          "unidad": {
            "type": "string",
            "default": "ud",
            "description": "Unidad (ud, h, mes, kg, m...)"
          },
          "notas": {
            "type": "string"
          }
        }
      }
    },
    "created_by_name": {
      "type": "string",
      "description": "Nombre del usuario que cre\u00f3 el cliente"
    },
    "company_id": {
      "type": "string",
      "description": "ID de empresa del t\u00e9cnico que lo gestiona"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario cliente vinculado"
    },
    "photo_url": {
      "type": "string",
      "description": "Foto o logo del cliente"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "scada_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Si el cliente tiene acceso al SCADA activado"
    },
    "scada_brands": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "loxone",
          "airzone"
        ]
      },
      "default": [],
      "description": "Marcas/sistemas SCADA habilitados para este cliente"
    }
  },
  "required": [
    "name",
    "cif"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.assigned_technician": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}