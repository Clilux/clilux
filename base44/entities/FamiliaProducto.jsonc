{
  "name": "FamiliaProducto",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre de la familia"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n de la familia"
    },
    "company_id": {
      "type": "string",
      "description": "ID de la empresa propietaria"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "nombre"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}