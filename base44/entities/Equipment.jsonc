{
  "name": "Equipment",
  "type": "object",
  "properties": {
    "reference_name": {
      "type": "string",
      "description": "Nombre de referencia del equipo"
    },
    "building_id": {
      "type": "string",
      "description": "ID del edificio"
    },
    "client_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "equipment_type": {
      "type": "string",
      "description": "Tipo de equipo"
    },
    "brand": {
      "type": "string",
      "description": "Marca del equipo"
    },
    "model": {
      "type": "string",
      "description": "Modelo"
    },
    "serial_number": {
      "type": "string",
      "description": "N\u00famero de serie"
    },
    "location": {
      "type": "string",
      "description": "Ubicaci\u00f3n dentro del edificio"
    },
    "installation_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de instalaci\u00f3n"
    },
    "registration_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de registro en el sistema"
    },
    "cooling_power_kw": {
      "type": "number",
      "description": "Potencia frigor\u00edfica (kW)"
    },
    "heating_power_kw": {
      "type": "number",
      "description": "Potencia calor\u00edfica (kW)"
    },
    "refrigerant_type": {
      "type": "string",
      "description": "Tipo de refrigerante"
    },
    "refrigerant_charge_kg": {
      "type": "number",
      "description": "Carga de refrigerante (kg)"
    },
    "balsa_litros": {
      "type": "number",
      "description": "Volumen de la balsa (litros) \u2014 solo equipos adiab\u00e1ticos/evaporativos"
    },
    "warranty_end": {
      "type": "string",
      "format": "date",
      "description": "Fin de garant\u00eda"
    },
    "first_revision_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la primera revisi\u00f3n programada"
    },
    "notes": {
      "type": "string",
      "description": "Observaciones"
    },
    "photo_url": {
      "type": "string",
      "description": "Foto principal del equipo"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Galer\u00eda de fotos del equipo"
    },
    "status": {
      "type": "string",
      "enum": [
        "operational",
        "maintenance_needed",
        "out_of_service"
      ],
      "default": "operational"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "description": "Documentos adjuntos"
    },
    "spare_parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "description": "Repuestos y consumibles"
    },
    "maintenance_config": {
      "type": "object",
      "properties": {
        "monthly_enabled": {
          "type": "boolean"
        },
        "monthly_fields": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "quarterly_enabled": {
          "type": "boolean"
        },
        "quarterly_fields": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "biannual_enabled": {
          "type": "boolean"
        },
        "biannual_fields": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "annual_enabled": {
          "type": "boolean"
        },
        "annual_fields": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "description": "Configuraci\u00f3n de campos de mantenimiento por periodicidad"
    },
    "technical_data": {
      "type": "object",
      "description": "Datos t\u00e9cnicos espec\u00edficos del equipo"
    },
    "parent_equipment_id": {
      "type": "string",
      "description": "ID de la unidad exterior"
    },
    "unit_type": {
      "type": "string",
      "enum": [
        "exterior",
        "interior",
        "standalone"
      ],
      "default": "standalone"
    },
    "created_by_name": {
      "type": "string",
      "description": "Nombre del t\u00e9cnico que cre\u00f3 el equipo"
    },
    "has_fluorinated_gas": {
      "type": "boolean",
      "default": false
    },
    "gwp": {
      "type": "number",
      "description": "GWP del refrigerante"
    },
    "co2_equivalent_tons": {
      "type": "number",
      "description": "Toneladas equivalentes de CO2"
    },
    "next_leak_check_date": {
      "type": "string",
      "format": "date"
    },
    "fgas_operator_name": {
      "type": "string"
    },
    "fgas_operator_nif": {
      "type": "string"
    },
    "fgas_certified_company": {
      "type": "string"
    },
    "fgas_company_cert_num": {
      "type": "string"
    },
    "fgas_tech_cert_num": {
      "type": "string"
    }
  },
  "required": [
    "building_id",
    "client_id",
    "equipment_type",
    "brand",
    "model",
    "registration_date"
  ]
}