{
  "name": "Ausencia",
  "type": "object",
  "properties": {
    "technician_id": {
      "type": "string",
      "description": "ID del t\u00e9cnico"
    },
    "technician_email": {
      "type": "string",
      "description": "Email del t\u00e9cnico"
    },
    "technician_name": {
      "type": "string",
      "description": "Nombre del t\u00e9cnico"
    },
    "company_id": {
      "type": "string",
      "description": "ID de la empresa"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "vacaciones",
        "baja_medica",
        "permiso",
        "asunto_propio",
        "maternidad_paternidad",
        "otro"
      ],
      "description": "Tipo de ausencia"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date",
      "description": "Fecha del primer d\u00eda solicitado"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date",
      "description": "Fecha del \u00faltimo d\u00eda solicitado"
    },
    "dias_solicitados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "D\u00edas laborables concretos solicitados (formato yyyy-MM-dd). Es la fuente de verdad del consumo de vacaciones."
    },
    "dias_totales": {
      "type": "number",
      "description": "N\u00famero de d\u00edas laborables solicitados"
    },
    "motivo": {
      "type": "string",
      "description": "Descripci\u00f3n o motivo"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "aprobada",
        "rechazada"
      ],
      "default": "pendiente",
      "description": "Estado de la solicitud"
    },
    "notas_admin": {
      "type": "string",
      "description": "Notas del administrador"
    },
    "documento_url": {
      "type": "string",
      "description": "Documento adjunto (parte m\u00e9dico, etc.)"
    }
  },
  "required": [
    "technician_email",
    "tipo",
    "fecha_inicio",
    "fecha_fin"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.technician_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.technician_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.technician_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.technician_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}