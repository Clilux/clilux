{
  "name": "Compra",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "description": "N\u00famero interno de la compra"
    },
    "num_factura": {
      "type": "string",
      "description": "N\u00ba de factura del proveedor"
    },
    "proveedor_id": {
      "type": "string"
    },
    "proveedor_nombre": {
      "type": "string"
    },
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "fecha_pago": {
      "type": "string",
      "format": "date"
    },
    "pedido_id": {
      "type": "string",
      "description": "Pedido de origen (opcional)"
    },
    "lineas": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "concepto": {
            "type": "string"
          },
          "cantidad": {
            "type": "number"
          },
          "precio_unitario": {
            "type": "number"
          },
          "descuento": {
            "type": "number",
            "default": 0
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "iva": {
      "type": "number",
      "default": 21
    },
    "total": {
      "type": "number"
    },
    "forma_pago": {
      "type": "string",
      "enum": [
        "contado",
        "transferencia",
        "tarjeta",
        "domiciliado"
      ],
      "default": "transferencia"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "pagada"
      ],
      "default": "pendiente"
    },
    "notas": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "numero",
    "fecha"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}