{
  "name": "Company",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Identificador \u00fanico de empresa (CIF en min\u00fasculas)"
    },
    "name": {
      "type": "string",
      "description": "Nombre o raz\u00f3n social de la empresa"
    },
    "cif": {
      "type": "string",
      "description": "CIF/NIF de la empresa"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n fiscal"
    },
    "city": {
      "type": "string",
      "description": "Ciudad"
    },
    "postal_code": {
      "type": "string",
      "description": "C\u00f3digo postal"
    },
    "province": {
      "type": "string",
      "description": "Provincia"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono de la empresa"
    },
    "email": {
      "type": "string",
      "description": "Email de contacto de la empresa"
    },
    "web": {
      "type": "string",
      "description": "Sitio web"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo de la empresa"
    },
    "habilitacion_rep": {
      "type": "string",
      "enum": [
        "EIP-1",
        "EIP-2"
      ],
      "description": "Habilitaci\u00f3n REP (Reglamento de Equipos a Presi\u00f3n): EIP-1 o EIP-2"
    },
    "modulos": {
      "type": "object",
      "description": "M\u00f3dulos contratados por la empresa. La app base (mantenimiento) siempre est\u00e1 activa; el resto se activan aqu\u00ed.",
      "properties": {
        "base": {
          "type": "boolean",
          "default": true,
          "description": "M\u00f3dulo base: mantenimiento (clientes, edificios, equipos, incidencias, revisiones). Siempre activo."
        },
        "automatizacion": {
          "type": "boolean",
          "default": false,
          "description": "M\u00f3dulo de Automatizaci\u00f3n: Loxone, Airzone y paneles SCADA."
        },
        "erp": {
          "type": "boolean",
          "default": false,
          "description": "M\u00f3dulo ERP: presupuestos, albaranes, pedidos, compras, art\u00edculos, proveedores."
        },
        "normativa": {
          "type": "object",
          "description": "Bloques de cumplimiento normativo opcionales.",
          "properties": {
            "rite": {
              "type": "boolean",
              "default": false,
              "description": "Cumplimiento RITE (Reglamento de Instalaciones T\u00e9rmicas)."
            },
            "legionela": {
              "type": "boolean",
              "default": false,
              "description": "Cumplimiento Legionela (L+D, RD 865/2003)."
            },
            "fgas": {
              "type": "boolean",
              "default": false,
              "description": "Cumplimiento F-Gas (libro de registro de gases fluorados)."
            },
            "equipos_presion": {
              "type": "boolean",
              "default": false,
              "description": "Cumplimiento REP (Reglamento de Equipos a Presi\u00f3n)."
            }
          }
        }
      }
    },
    "suscripcion": {
      "type": "object",
      "description": "Estado de la suscripci\u00f3n/pago del cliente de la app. Lo gestiona el administrador de la plataforma desde el panel de administraci\u00f3n.",
      "properties": {
        "estado": {
          "type": "string",
          "enum": [
            "prueba",
            "activa",
            "pendiente",
            "vencida",
            "suspendida",
            "cancelada"
          ],
          "default": "prueba",
          "description": "Estado de pago: prueba (per\u00edodo de prueba), activa (al corriente), pendiente (pago emitado sin cobrar), vencida (paso del plazo), suspendida (acceso cortado por impago), cancelada (baja)."
        },
        "ciclo": {
          "type": "string",
          "enum": [
            "mensual",
            "trimestral",
            "anual"
          ],
          "default": "mensual",
          "description": "Ciclo de facturaci\u00f3n de la suscripci\u00f3n."
        },
        "importe": {
          "type": "number",
          "default": 0,
          "description": "Importe por ciclo (sin IVA) que paga el cliente."
        },
        "fecha_inicio": {
          "type": "string",
          "format": "date",
          "description": "Fecha de alta de la suscripci\u00f3n."
        },
        "fecha_ultimo_pago": {
          "type": "string",
          "format": "date",
          "description": "Fecha del \u00faltimo pago cobrado."
        },
        "fecha_proximo_pago": {
          "type": "string",
          "format": "date",
          "description": "Fecha del pr\u00f3ximo cobro/vencimiento."
        },
        "metodo": {
          "type": "string",
          "enum": [
            "manual",
            "stripe",
            "wix"
          ],
          "default": "manual",
          "description": "M\u00e9todo de cobro: manual (gestionado a mano) o pasarela online (stripe/wix) para el portal de pago futuro."
        },
        "subscription_id": {
          "type": "string",
          "description": "ID de suscripci\u00f3n en la pasarela de pago (para el portal online futuro)."
        },
        "dias_prueba": {
          "type": "number",
          "default": 14,
          "description": "D\u00edas de per\u00edodo de prueba concedidos."
        },
        "notas": {
          "type": "string",
          "description": "Notas internas sobre el pago o la suscripci\u00f3n."
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Indica si el gerente complet\u00f3 el asistente de primera configuraci\u00f3n"
    }
  },
  "required": [
    "company_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}