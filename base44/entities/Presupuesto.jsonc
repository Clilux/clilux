{
  "name": "Presupuesto",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "description": "N\u00famero de presupuesto"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo / objeto del presupuesto"
    },
    "client_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "cliente_nombre": {
      "type": "string",
      "description": "Nombre del cliente (desnormalizado)"
    },
    "company_id": {
      "type": "string",
      "description": "ID de la empresa propietaria del presupuesto"
    },
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha del presupuesto"
    },
    "fecha_validez": {
      "type": "string",
      "format": "date",
      "description": "V\u00e1lido hasta"
    },
    "fecha_envio": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora del \u00faltimo env\u00edo al cliente"
    },
    "enviado_a": {
      "type": "string",
      "description": "Email al que se envi\u00f3 el presupuesto"
    },
    "arbol": {
      "type": "array",
      "description": "Estructura jer\u00e1rquica compatible con Presto (FIEBDC-3). Cada nodo: { id, tipo: 'capitulo'|'subcapitulo'|'partida', natc (1 cap\u00edtulo / 2 partida), codigo, resumen, texto, unidad, precio, mediciones: [{ etiqueta, unidades, longitud, ancho, alto }], hijos: [] }. Regla de oro: un nodo contiene solo cap\u00edtulos o solo partidas, nunca mezclados.",
      "items": {
        "type": "object"
      }
    },
    "lineas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "description": "C\u00f3digo del art\u00edculo (cat\u00e1logo o BC3)"
          },
          "concepto": {
            "type": "string"
          },
          "unidad": {
            "type": "string",
            "default": "ud"
          },
          "cantidad": {
            "type": "number"
          },
          "precio_unitario": {
            "type": "number"
          },
          "descuento": {
            "type": "number",
            "default": 0
          },
          "total": {
            "type": "number"
          }
        }
      },
      "description": "Partidas aplanadas del \u00e1rbol (se mantiene sincronizada para listados y totales)"
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal sin IVA"
    },
    "iva": {
      "type": "number",
      "default": 21,
      "description": "Porcentaje IVA"
    },
    "total": {
      "type": "number",
      "description": "Total con IVA"
    },
    "observaciones": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "borrador",
        "enviado",
        "aceptado",
        "rechazado"
      ],
      "default": "borrador"
    },
    "convertido_albaran": {
      "type": "boolean",
      "default": false
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "fecha"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}